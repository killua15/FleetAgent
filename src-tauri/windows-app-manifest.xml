<?xml version="1.0" encoding="utf-8"?>
<!--
  Embedded into the *test* executables only, by `build.rs`.

  The app's own binary gets its manifest from `tauri-build`. Test binaries get
  nothing, and on Windows that is fatal rather than cosmetic: without the
  Common Controls v6 dependency below, `comctl32.dll` resolves to the v5 copy
  in system32, which does not export the subclassing symbols Tauri's window
  code imports. The loader then kills the process before `main` with
  STATUS_ENTRYPOINT_NOT_FOUND (0xc0000139) — every test "fails" at once, with
  no output and no indication of what happened.

  Upstream bug: https://github.com/tauri-apps/tauri/issues/13419
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*"
      />
    </dependentAssembly>
  </dependency>
</assembly>
